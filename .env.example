# Copie para .env em produção (Render/Railway já injetam essas variáveis
# no ambiente, então normalmente você só precisa configurá-las no painel
# do serviço, não subir um arquivo .env).

DJANGO_SECRET_KEY=troque-por-uma-chave-aleatoria-longa
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=seuapp.onrender.com

# Deixe em branco para usar SQLite local. Em produção, cole a URL que o
# Render/Railway/Neon te dão ao criar um banco PostgreSQL gratuito.
DATABASE_URL=

# Opcionais — sem essas chaves o app funciona igual, só sem foto real (usa
# fallback da Wikipedia) e sem o coach com IA (o painel nem aparece).
PEXELS_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
